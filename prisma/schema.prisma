// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Windows host + WSL/Linux (Next often runs under /mnt/d via WSL)
  binaryTargets = ["native", "windows", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContentIndex {
  id           String   @id @default(cuid())
  subname      String   @unique
  contentHash  String
  ownerAddress String
  timestamp    DateTime
  originUrl    String
  license      String
  revoked      Boolean  @default(false)

  @@index([contentHash])
  @@index([ownerAddress])
}
